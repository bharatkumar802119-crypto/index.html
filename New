<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UPSC GS Paper-I QCAB Simulator (XXX-X-GSI/20)</title>
<link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Noto+Serif+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #e5e1d8; font-family: 'Noto Serif Devanagari', serif; color: #1a1a1a; }

  /* Sticky Control Bar */
  .toolbar {
    position: sticky; top: 0; z-index: 200;
    background: #1e293b; color: #fff;
    padding: 8px 12px; display: flex; flex-wrap: wrap;
    gap: 8px; align-items: center; justify-content: space-between;
    box-shadow: 0 3px 10px rgba(0,0,0,0.3);
  }
  .toolbar-group { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .toolbar select, .toolbar button {
    padding: 6px 10px; border-radius: 6px; border: 1px solid #475569;
    font-size: 13px; cursor: pointer; font-family: inherit;
  }
  .toolbar select { background: #0f172a; color: #f8fafc; max-width: 210px; }
  .toolbar button { background: #334155; color: #fff; }
  .toolbar button.active { background: #eab308; color: #0f172a; font-weight: 700; border-color: #eab308; }
  .btn-gold { background: #eab308 !important; color: #0f172a !important; font-weight: 700; border: none !important; }
  .btn-danger { background: #991b1b !important; color: #fff !important; border: none !important; }
  .timer-box { background: #0f172a; border: 1px solid #334155; padding: 5px 10px; border-radius: 6px; font-family: monospace; font-size: 14px; color: #4ade80; display: flex; align-items: center; gap: 6px; }
  .ink-btn { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #94a3b8; cursor: pointer; display: inline-block; }
  .ink-btn.selected { border-color: #eab308; transform: scale(1.15); }

  /* Booklet Container */
  .sheet-wrap { max-width: 830px; margin: 16px auto; padding: 0 8px 70px; }
  .qcab-page {
    background: #fff; border: 1px solid #cbd5e1;
    box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    margin-bottom: 26px; position: relative;
    min-height: 1020px; display: flex; flex-direction: column;
  }

  /* Cover & Instructions Styling */
  .cover-box { padding: 24px 28px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .cover-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #1e293b; padding-bottom: 14px; }
  .qr-mock { width: 76px; height: 76px; border: 2px solid #1e293b; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; text-align: center; }
  .official-box { border: 1.5px solid #1e293b; padding: 10px 16px; font-size: 12px; text-align: center; }
  .inst-box { border: 1.5px solid #1e293b; padding: 14px; margin: 14px 0; font-size: 13px; line-height: 1.6; }
  .cand-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
  .cand-table td, .cand-table th { border: 1.5px solid #1e293b; padding: 8px 10px; }
  .cand-input { width: 100%; border: none; border-bottom: 1px dashed #64748b; font-family: 'Kalam', cursive; font-size: 16px; color: #1d4ed8; outline: none; background: transparent; }

  /* Answer Sheet Grid */
  .page-top { display: flex; justify-content: space-between; padding: 7px 16px; font-size: 11px; color: #475569; border-bottom: 1px solid #e2e8f0; }
  .page-grid { display: grid; grid-template-columns: 54px 1fr 72px; flex: 1; position: relative; }
  .margin-left { border-right: 1.5px solid #1e293b; padding: 14px 4px; font-weight: 700; font-size: 15px; text-align: center; }
  .margin-right { border-left: 1.5px solid #1e293b; padding: 12px 4px; font-size: 9px; color: #334155; text-align: center; line-height: 1.35; }
  .content-area { padding: 14px 16px; position: relative; display: flex; flex-direction: column; }

  .q-box { border-bottom: 1px solid #94a3b8; padding-bottom: 10px; margin-bottom: 12px; }
  .q-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px; }
  .badge { background: #f1f5f9; border: 1px solid #cbd5e1; padding: 3px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
  .q-text-hi { font-size: 15px; font-weight: 700; line-height: 1.55; margin-bottom: 4px; }
  .q-text-en { font-size: 13.5px; color: #334155; line-height: 1.45; }

  /* Writing & Drawing Layers */
  .writing-stack { position: relative; flex: 1; min-height: 700px; }
  .answer-editor {
    width: 100%; height: 100%; min-height: 700px; outline: none;
    font-family: 'Kalam', cursive; font-size: 19.5px; line-height: 1.85;
    color: #1d4ed8; white-space: pre-wrap; position: relative; z-index: 2;
  }
  .answer-editor:empty:before {
    content: attr(data-placeholder); color: #94a3b8; font-style: italic; font-size: 16px;
  }
  .draw-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 1; pointer-events: none; touch-action: none;
  }
  body.pen-mode .draw-canvas { z-index: 5; pointer-events: auto; cursor: crosshair; }

  .watermark {
    position: absolute; top: 52%; left: 50%; transform: translate(-50%, -50%) rotate(-38deg);
    font-size: 64px; font-weight: 700; color: rgba(234, 88, 12, 0.11);
    pointer-events: none; letter-spacing: 6px; user-select: none; z-index: 0;
  }
  .page-foot { display: flex; justify-content: space-between; padding: 6px 16px; font-size: 11px; color: #334155; border-top: 1px solid #e2e8f0; }

  .cancelled-stamp {
    position: absolute; inset: 0; background: rgba(254, 226, 226, 0.45);
    display: none; align-items: center; justify-content: center; pointer-events: none; z-index: 20;
  }
  .cancelled-stamp span {
    border: 4px solid #dc2626; color: #dc2626; font-size: 32px; font-weight: 700;
    padding: 8px 24px; transform: rotate(-22deg); background: rgba(255,255,255,0.9);
  }

  @media print {
    .toolbar, .no-print { display: none !important; }
    body { background: #fff; }
    .sheet-wrap { max-width: 100%; margin: 0; padding: 0; }
    .qcab-page { box-shadow: none; border: none; page-break-after: always; margin: 0; min-height: 100vh; }
  }
</style>
</head>
<body>

<div class="toolbar no-print">
  <div class="toolbar-group">
    <select id="paperSelect" onchange="changePaper()">
      <option value="2020">GS-I 2020 (Official)</option>
      <option value="2023">GS-I 2023 अभ्यास</option>
      <option value="2024">GS-I 2024 अभ्यास</option>
      <option value="2025">GS-I 2025 अभ्यास</option>
      <option value="custom">खाली अभ्यास पुस्तिका</option>
    </select>
    <select id="qNav" onchange="scrollToSection(this.value)"></select>
  </div>

  <div class="toolbar-group">
    <button id="btnTypeMode" class="active" onclick="setMode('type')">⌨️ टाइपिंग</button>
    <button id="btnPenMode" onclick="setMode('pen')">✍️ पेन / पेंसिल</button>
    <button onclick="execCmd('underline')" title="Underline"><b><u>U</u></b></button>
    <button onclick="wrapBox()" title="Box Keyword">[Box]</button>
    <span class="ink-btn selected" id="inkBlue" style="background:#1d4ed8;" title="नीली स्याही" onclick="setInk('#1d4ed8', this)"></span>
    <span class="ink-btn" id="inkBlack" style="background:#111827;" title="काली स्याही" onclick="setInk('#111827', this)"></span>
    <span class="ink-btn" id="inkPencil" style="background:#64748b;" title="पेंसिल (केवल आरेख/मानचित्र हेतु)" onclick="setPencil(this)"></span>
  </div>

  <div class="toolbar-group">
    <div class="timer-box">
      <span id="timerDisplay">03:00:00</span>
      <button onclick="toggleTimer()" id="timerBtn" style="padding:2px 6px; font-size:11px;">▶</button>
    </div>
    <button class="btn-gold" onclick="window.print()">🖨️ PDF / प्रिंट</button>
    <button class="btn-danger" onclick="resetBooklet()" title="सब साफ़ करें">↺</button>
  </div>
</div>

<div class="sheet-wrap" id="bookletContainer"></div>

