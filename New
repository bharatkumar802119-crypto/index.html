let activePaper = '2020';
let currentInk = '#1d4ed8';
let strokeColor = '#1d4ed8';
let currentMode = 'type';
let secondsLeft = 3 * 3600;
let timerInterval = null;

function setMode(mode) {
  currentMode = mode;
  document.body.classList.toggle('pen-mode', mode === 'pen');
  document.getElementById('btnTypeMode').classList.toggle('active', mode === 'type');
  document.getElementById('btnPenMode').classList.toggle('active', mode === 'pen');
}

function setInk(color, el) {
  currentInk = color;
  strokeColor = color;
  document.querySelectorAll('.ink-btn').forEach(b => b.classList.remove('selected'));
  if (el) el.classList.add('selected');
  document.querySelectorAll('.answer-editor').forEach(ed => ed.style.color = color);
}

function setPencil(el) {
  strokeColor = '#64748b';
  document.querySelectorAll('.ink-btn').forEach(b => b.classList.remove('selected'));
  if (el) el.classList.add('selected');
  setMode('pen');
}

function execCmd(cmd) { document.execCommand(cmd, false, null); }

function wrapBox() {
  const sel = window.getSelection();
  if (!sel.rangeCount) return;
  const text = sel.toString();
  if (text) {
    document.execCommand('insertHTML', false, '<span style="border:1.5px solid currentColor; padding:1px 6px; border-radius:3px;">' + text + '</span>');
  }
}

function toggleTimer() {
  const btn = document.getElementById('timerBtn');
  if (timerInterval) {
    clearInterval(timerInterval);
    timerInterval = null;
    btn.innerText = '▶';
  } else {
    btn.innerText = '⏸';
    timerInterval = setInterval(() => {
      if (secondsLeft > 0) {
        secondsLeft--;
        const h = String(Math.floor(secondsLeft / 3600)).padStart(2, '0');
        const m = String(Math.floor((secondsLeft % 3600) / 60)).padStart(2, '0');
        const s = String(secondsLeft % 60).padStart(2, '0');
        document.getElementById('timerDisplay').innerText = `${h}:${m}:${s}`;
      }
    }, 1000);
  }
}

function changePaper() {
  activePaper = document.getElementById('paperSelect').value;
  renderBooklet();
}

function editQ(idx) {
  const item = PAPERS[activePaper][idx];
  const newHi = prompt("नया प्रश्न (हिंदी में) लिखें:", item.hi);
  if (newHi !== null && newHi.trim() !== "") {
    item.hi = newHi.trim();
    const newEn = prompt("New Question (in English - optional):", item.en);
    if (newEn !== null) item.en = newEn.trim();
    renderBooklet();
  }
}

function toggleCancel(qNum) {
  const el = document.getElementById('cancel-' + qNum);
  el.style.display = el.style.display === 'flex' ? 'none' : 'flex';
}

function countWords(qNum, limit) {
  let total = 0;
  document.querySelectorAll('.ed-q-' + qNum).forEach(ed => {
    const txt = ed.innerText.trim();
    if (txt) total += txt.split(/\s+/).length;
  });
  document.getElementById('wc-' + qNum).innerText = `${total} / ${limit} शब्द`;
  saveProgress();
}

function scrollToSection(id) {
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
}

function initCanvases() {
  document.querySelectorAll('.draw-canvas').forEach(canvas => {
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width || 650;
    canvas.height = rect.height || 700;
    const ctx = canvas.getContext('2d');
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    let drawing = false;

    const getPos = (e) => {
      const r = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: clientX - r.left, y: clientY - r.top };
    };

    const start = (e) => {
      if (currentMode !== 'pen') return;
      drawing = true;
      const p = getPos(e);
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.strokeStyle = strokeColor;
      ctx.lineWidth = strokeColor === '#64748b' ? 1.5 : 2;
    };
    const move = (e) => {
      if (!drawing || currentMode !== 'pen') return;
      e.preventDefault();
      const p = getPos(e);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
    };
    const end = () => { drawing = false; };

    canvas.addEventListener('mousedown', start);
    canvas.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    canvas.addEventListener('touchstart', start, { passive: false });
    canvas.addEventListener('touchmove', move, { passive: false });
    canvas.addEventListener('touchend', end);
  });
}

function saveProgress() {
  const data = {};
  document.querySelectorAll('.answer-editor').forEach(ed => {
    if (ed.id) data[ed.id] = ed.innerHTML;
  });
  try { localStorage.setItem('vardaraj_qcab_' + activePaper, JSON.stringify(data)); } catch (e) {}
}

function loadProgress() {
  try {
    const raw = localStorage.getItem('vardaraj_qcab_' + activePaper);
    if (!raw) return;
    const data = JSON.parse(raw);
    Object.keys(data).forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = data[id];
    });
  } catch (e) {}
}

function resetBooklet() {
  if (confirm("क्या आप इस पुस्तिका के सभी लिखे हुए उत्तर साफ़ करना चाहते हैं?")) {
    localStorage.removeItem('vardaraj_qcab_' + activePaper);
    renderBooklet();
  }
}

